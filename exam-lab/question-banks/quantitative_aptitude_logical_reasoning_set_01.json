      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "medium",
      "question": "A can complete a task in 12 days and B can complete it in 18 days. How many days will they take working together?",
      "options": [
        {
          "id": "A",
          "text": "6 days"
        },
        {
          "id": "B",
          "text": "8 days"
        },
        {
          "id": "C",
          "text": "7.2 days"
        },
        {
          "id": "D",
          "text": "9 days"
        }
      ],
      "correctAnswer": "C",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "Combined daily work = 1/12 + 1/18 = 5/36. Time = 36/5 = 7.2 days."
    },
    {
      "id": "Q007",
      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "hard",
      "question": "A sum of money becomes ₹13,200 in 2 years and ₹14,400 in 4 years at simple interest. What is the principal?",
      "options": [
        {
          "id": "A",
          "text": "₹12,000"
        },
        {
          "id": "B",
          "text": "₹11,400"
        },
        {
          "id": "C",
          "text": "₹12,400"
        },
        {
          "id": "D",
          "text": "₹10,800"
        }
      ],
      "correctAnswer": "A",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "Interest for 2 years = 14,400 − 13,200 = ₹1,200. Annual interest = ₹600. Principal = 13,200 − 2 × 600 = ₹12,000."
    },
    {
      "id": "Q008",
      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "medium",
      "question": "The ratio of the ages of A and B is 4:5. After 6 years, their ages will be in the ratio 5:6. What is A's present age?",
      "options": [
        {
          "id": "A",
          "text": "20 years"
        },
        {
          "id": "B",
          "text": "18 years"
        },
        {
          "id": "C",
          "text": "30 years"
        },
        {
          "id": "D",
          "text": "24 years"
        }
      ],
      "correctAnswer": "D",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "Let ages be 4x and 5x. (4x + 6)/(5x + 6) = 5/6. Solving gives x = 6, so A's age = 24 years."
    },
    {
      "id": "Q009",
      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "easy",
      "question": "What is the least common multiple of 12, 18 and 30?",
      "options": [
        {
          "id": "A",
          "text": "90"
        },
        {
          "id": "B",
          "text": "180"
        },
        {
          "id": "C",
          "text": "120"
        },
        {
          "id": "D",
          "text": "360"
        }
      ],
      "correctAnswer": "B",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "12 = 2^2 × 3, 18 = 2 × 3^2, 30 = 2 × 3 × 5. LCM = 2^2 × 3^2 × 5 = 180."
    },
