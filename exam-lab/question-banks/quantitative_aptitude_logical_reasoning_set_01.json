    {
      "id": "Q001",
      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "easy",
      "question": "What is 25% of 480?",
      "options": [
        {
          "id": "A",
          "text": "100"
        },
        {
          "id": "B",
          "text": "120"
        },
        {
          "id": "C",
          "text": "125"
        },
        {
          "id": "D",
          "text": "140"
        }
      ],
      "correctAnswer": "B",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "25% of 480 = 480 × 25/100 = 120."
    },
    {
      "id": "Q002",
      "section": "Quantitative Aptitude",
      "type": "single_choice",
      "difficulty": "easy",
      "question": "A product costs ₹800 and is sold at a profit of 15%. What is its selling price?",
      "options": [
        {
          "id": "A",
          "text": "₹900"
        },
        {
          "id": "B",
          "text": "₹880"
        },
        {
          "id": "C",
          "text": "₹920"
        },
        {
          "id": "D",
          "text": "₹940"
        }
      ],
      "correctAnswer": "C",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "Profit = 15% of 800 = ₹120. Selling price = 800 + 120 = ₹920."
    },
    {
