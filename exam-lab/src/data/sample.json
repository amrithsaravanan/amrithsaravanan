      "type": "single_choice",
      "difficulty": "easy",
      "question": "What is 20% of 250?",
      "options": [
        {
          "id": "A",
          "text": "25"
        },
        {
          "id": "B",
          "text": "40"
        },
        {
          "id": "C",
          "text": "50"
        },
        {
          "id": "D",
          "text": "60"
        }
      ],
      "correctAnswer": "C",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "20/100 × 250 = 50."
    },
    {
