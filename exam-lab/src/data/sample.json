      "type": "single_choice",
      "difficulty": "easy",
      "question": "A train travelling at 60 km/h covers 150 km in how many hours?",
      "options": [
        {
          "id": "A",
          "text": "2"
        },
        {
          "id": "B",
          "text": "2.5"
        },
        {
          "id": "C",
          "text": "3"
        },
        {
          "id": "D",
          "text": "3.5"
        }
      ],
      "correctAnswer": "B",
      "marks": 1,
      "negativeMarks": 0.25,
      "explanation": "Time = distance ÷ speed = 150 ÷ 60 = 2.5 hours."
    },
